<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.HotkeyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown">

    <Grid>
        <!-- Dimming backdrop — click outside panel to close -->
        <Rectangle Fill="#88000000" MouseDown="Backdrop_MouseDown"/>

        <!-- Centered content panel (width set in code) -->
        <Border x:Name="ContentPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="520"
                Background="#EF09141E"
                BorderBrush="#153048"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#060F18"
                        BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <TextBlock x:Name="HeaderText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HintText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" Foreground="#1A3A55"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Chapter content — built entirely in code-behind -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="16,14" MaxHeight="480">
                    <StackPanel x:Name="ChaptersPanel"/>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#060F18"
                        BorderBrush="#0D2030" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <Button x:Name="LoadBtn"
                                Height="36" MinWidth="180"
                                local:ButtonHelper.CornerRadius="3"
                                Background="#00503C" BorderBrush="#00B482" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="LoadBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"
                                           FontSize="14" Foreground="#00CCAA"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LoadBtnText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold" Foreground="#00CCAA"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseBtn"
                                Height="36" MinWidth="120"
                                local:ButtonHelper.CornerRadius="3"
                                Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseBtn_Click">
                            <TextBlock x:Name="CloseBtnText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"/>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
