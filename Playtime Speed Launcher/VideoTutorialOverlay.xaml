<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.VideoTutorialOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- Seek progress slider -->
        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00CCAA" Height="4" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#0D2030" Height="4" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#00CCAA"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="12" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00CCAA" Height="3" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#0D2030" Height="3" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="#8AABBD"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom scrollbar thumb -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#1A3A55" CornerRadius="3" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom vertical scrollbar (thin, dark) -->
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#050C14" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollViewer template -->
        <Style x:Key="CustomScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource CustomScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Dimming backdrop -->
        <Rectangle Fill="#BB000000" MouseDown="Backdrop_MouseDown"/>

        <!-- Main panel -->
        <Border Width="1200" Height="740"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#EF07101A"
                BorderBrush="#153048" BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Border Grid.Row="0" Background="#05090F"
                        BorderBrush="#0D2030" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00CCAA"
                                     Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SKIPS AND GLITCHES"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="Close_Click"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                local:ButtonHelper.CornerRadius="4"
                                Background="#0A1825" BorderBrush="#0D2535"
                                BorderThickness="1" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                       Foreground="#3A6A8A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Content ── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Sidebar ── -->
                    <Border Grid.Column="0" Background="#04080E"
                            BorderBrush="#0D2030" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search bar -->
                            <Border Grid.Row="0" Margin="10,10,10,8"
                                    Background="#060D18" BorderBrush="#0D2030"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Foreground="#1A3A55"
                                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    <TextBox x:Name="SearchBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#8AABBD"
                                             CaretBrush="#00CCAA"
                                             SelectionBrush="#00CCAA"
                                             FontFamily="Cascadia Code, Consolas, Courier New"
                                             FontSize="11"
                                             Padding="28,7,8,7"
                                             VerticalAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Text="Search videos... (@author)"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11" Foreground="#1A3A55"
                                               VerticalAlignment="Center" Margin="28,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Filters -->
                            <Border Grid.Row="1" Padding="10,0,10,8"
                                    Background="#04080E"
                                    BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                                <StackPanel x:Name="FiltersPanel"/>
                            </Border>

                            <!-- Video list -->
                            <ScrollViewer Grid.Row="2"
                                          x:Name="VideoListScroller"
                                          Style="{StaticResource CustomScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="10,0,4,10"
                                          PreviewMouseWheel="VideoList_PreviewMouseWheel">
                                <StackPanel x:Name="VideoListPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── Player area ── -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Video -->
                        <Grid Grid.Row="0" Background="#000000">
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="Uniform"
                                          MediaOpened="Player_MediaOpened"
                                          MediaEnded="Player_MediaEnded"/>
                            <StackPanel x:Name="EmptyState"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="56" Foreground="#0A1E2E"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyStateLabel"
                                           Text="Select a video"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" Foreground="#1A3A55"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <Border x:Name="LoadingBarTrack"
                                        Width="220" Height="4" Margin="0,14,0,0"
                                        Background="#0D2030" CornerRadius="2"
                                        Visibility="Collapsed" ClipToBounds="True">
                                    <Border x:Name="LoadingBarFill"
                                            Width="220" Height="4" Background="#00CCAA"
                                            CornerRadius="2" HorizontalAlignment="Left"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Seek bar -->
                        <Grid Grid.Row="1" Background="#040810">
                            <Slider x:Name="ProgressSlider"
                                    Style="{StaticResource SeekSlider}"
                                    Minimum="0" Maximum="100" Value="0"
                                    IsEnabled="False"
                                    VerticalAlignment="Center" Margin="14,0"
                                    ValueChanged="ProgressSlider_ValueChanged"/>
                        </Grid>

                        <!-- Controls -->
                        <Border Grid.Row="2" Background="#040810"
                                BorderBrush="#0D2030" BorderThickness="0,1,0,1">
                            <Grid Margin="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayPauseBtn"
                                            Width="40" Height="40"
                                            local:ButtonHelper.CornerRadius="20"
                                            Background="#0D2030" BorderBrush="#00CCAA"
                                            BorderThickness="1" IsEnabled="False"
                                            Cursor="Hand" Click="PlayPause_Click">
                                        <TextBlock x:Name="PlayPauseIcon"
                                                   Text="&#xE768;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="#00CCAA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock x:Name="TimeLabel"
                                               Text="0:00 / 0:00"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="10" Foreground="#3A6A8A"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="VolumeIcon"
                                               Text="&#xE767;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="#1A3A55"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Cursor="Hand" MouseDown="VolumeIcon_MouseDown"/>
                                    <Slider x:Name="VolumeSlider"
                                            Style="{StaticResource VolumeSlider}"
                                            Minimum="0" Maximum="1" Value="0.8"
                                            Width="90" VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Video info -->
                        <Border Grid.Row="3" Padding="16,10,16,16" Background="#03070D"
                                CornerRadius="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="VideoTitle"
                                           Text="No video selected"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#C8D8E4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="VideoCategoryLabel"
                                           Text=""
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" Foreground="#00CCAA"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="VideoDescription"
                                           Text=""
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10" Foreground="#3A6A8A"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
