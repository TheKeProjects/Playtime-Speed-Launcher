<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.BeginnerTutorialOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown">

    <Window.Resources>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00CCAA" Height="4" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#0D2030" Height="4" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#00CCAA"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="12" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00CCAA" Height="3" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#0D2030" Height="3" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="#8AABBD"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Dimming backdrop -->
        <Rectangle Fill="#BB000000" MouseDown="Backdrop_MouseDown"/>

        <!-- Main panel -->
        <Border Width="1000" Height="680"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#EF07101A"
                BorderBrush="#0D3020" BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Border Grid.Row="0" Background="#05090F"
                        BorderBrush="#0D2030" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid Margin="12,0,12,0">

                        <!-- Back button (player view only) -->
                        <Button x:Name="BackBtn"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="28" Height="28"
                                local:ButtonHelper.CornerRadius="4"
                                Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                Cursor="Hand" Click="BackBtn_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;"
                                       FontSize="11" Foreground="#3A6A8A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Title -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="44,0,0,0">
                            <Ellipse Width="8" Height="8" Fill="#00CCAA"
                                     Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderTitle"
                                       Text="BEGINNER TUTORIALS"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close button -->
                        <Button Click="Close_Click"
                                Width="28" Height="28"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                local:ButtonHelper.CornerRadius="4"
                                Background="#0A1825" BorderBrush="#0D2535"
                                BorderThickness="1" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                       Foreground="#3A6A8A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                    </Grid>
                </Border>

                <!-- ── Cards panel ── -->
                <UniformGrid x:Name="CardsPanel"
                             Grid.Row="1"
                             Rows="2" Columns="2"
                             Margin="14">

                    <!-- Card 1: ADD A INSTALLED VERSION -->
                    <Border x:Name="Card1"
                            Tag="mNz257eeAec"
                            Margin="5" CornerRadius="4"
                            Background="#0A1A28" BorderBrush="#0D2535" BorderThickness="1"
                            Cursor="Hand" ClipToBounds="True"
                            MouseDown="Card_MouseDown"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0"
                                   Source="https://img.youtube.com/vi/mNz257eeAec/maxresdefault.jpg"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Background="#05101A" Padding="8,5,8,7">
                                <TextBlock Text="ADD A INSTALLED VERSION"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#C8D8E4" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2: INSTALL A DEPOT AUTOMATICALLY -->
                    <Border x:Name="Card2"
                            Tag="FAOt2QUJIv0"
                            Margin="5" CornerRadius="4"
                            Background="#0A1A28" BorderBrush="#0D2535" BorderThickness="1"
                            Cursor="Hand" ClipToBounds="True"
                            MouseDown="Card_MouseDown"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0"
                                   Source="https://img.youtube.com/vi/FAOt2QUJIv0/maxresdefault.jpg"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Background="#05101A" Padding="8,5,8,7">
                                <TextBlock Text="INSTALL A DEPOT AUTOMATICALLY"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#C8D8E4" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3: INSTALL A DEPOT MANUAL -->
                    <Border x:Name="Card3"
                            Tag="Nc4OVsv1cs0"
                            Margin="5" CornerRadius="4"
                            Background="#0A1A28" BorderBrush="#0D2535" BorderThickness="1"
                            Cursor="Hand" ClipToBounds="True"
                            MouseDown="Card_MouseDown"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0"
                                   Source="https://img.youtube.com/vi/Nc4OVsv1cs0/maxresdefault.jpg"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Background="#05101A" Padding="8,5,8,7">
                                <TextBlock Text="INSTALL A DEPOT MANUAL"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#C8D8E4" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 4: OPEN THE CHECKPOINT LOADER -->
                    <Border x:Name="Card4"
                            Tag="JwE_bhk91Rc"
                            Margin="5" CornerRadius="4"
                            Background="#0A1A28" BorderBrush="#0D2535" BorderThickness="1"
                            Cursor="Hand" ClipToBounds="True"
                            MouseDown="Card_MouseDown"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0"
                                   Source="https://img.youtube.com/vi/JwE_bhk91Rc/maxresdefault.jpg"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Background="#05101A" Padding="8,5,8,7">
                                <TextBlock Text="OPEN THE CHECKPOINT LOADER"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#C8D8E4" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                </UniformGrid>

                <!-- ── Player panel (replaces cards after selection) ── -->
                <Grid x:Name="PlayerPanel"
                      Grid.Row="1"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <!-- Video area -->
                    <Grid Grid.Row="0" Background="#000000">
                        <MediaElement x:Name="Player"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened"
                                      MediaEnded="Player_MediaEnded"/>
                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyStateLabel"
                                       Text="LOADING, PLEASE WAIT"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="11" Foreground="#1A3A55"
                                       HorizontalAlignment="Center"/>
                            <Border x:Name="LoadingBarTrack"
                                    Width="200" Height="4" Margin="0,14,0,0"
                                    Background="#0D2030" CornerRadius="2"
                                    ClipToBounds="True">
                                <Border Width="200" Height="4" Background="#00CCAA"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Seek bar -->
                    <Grid Grid.Row="1" Background="#040810">
                        <Slider x:Name="ProgressSlider"
                                Style="{StaticResource SeekSlider}"
                                Minimum="0" Maximum="100" Value="0"
                                IsEnabled="False"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" Margin="14,0"
                                ValueChanged="ProgressSlider_ValueChanged"/>
                    </Grid>

                    <!-- Controls -->
                    <Border Grid.Row="2" Background="#040810"
                            BorderBrush="#0D2030" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8">
                        <Grid Margin="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayPauseBtn"
                                        Width="40" Height="40"
                                        local:ButtonHelper.CornerRadius="20"
                                        Background="#0D2030" BorderBrush="#00CCAA"
                                        BorderThickness="1" IsEnabled="False"
                                        Cursor="Hand" Click="PlayPause_Click">
                                    <TextBlock x:Name="PlayPauseIcon"
                                               Text="&#xE768;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Foreground="#00CCAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock x:Name="TimeLabel"
                                           Text="0:00 / 0:00"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10" Foreground="#3A6A8A"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="VolumeIcon"
                                           Text="&#xE767;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#1A3A55"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Cursor="Hand" MouseDown="VolumeIcon_MouseDown"/>
                                <Slider x:Name="VolumeSlider"
                                        Style="{StaticResource VolumeSlider}"
                                        Minimum="0" Maximum="1" Value="0.8"
                                        Width="90" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>
