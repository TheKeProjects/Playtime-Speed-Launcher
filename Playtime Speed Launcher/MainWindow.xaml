                                     CaretBrush="#9944CC"
                                     Padding="8,6"
                                     Margin="0,0,0,14"/>

                            <!-- Error title (required) -->
                            <TextBlock x:Name="BugETitleLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#9944CC"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="BugETitleBox"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="11"
                                     Background="#080C18" Foreground="#CCEEFF"
                                     BorderBrush="#2A1050" BorderThickness="1"
                                     CaretBrush="#9944CC"
                                     Padding="8,6"
                                     Margin="0,0,0,14"/>

                            <!-- Description (required) -->
                            <TextBlock x:Name="BugDescLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#9944CC"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="BugDescBox"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="11"
                                     Background="#080C18" Foreground="#AABBCC"
                                     BorderBrush="#2A1050" BorderThickness="1"
                                     CaretBrush="#9944CC"
                                     Padding="8,6"
                                     Height="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,14"/>

                            <!-- Image (optional) -->
                            <TextBlock x:Name="BugImageLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#5522AA"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BugImageBtn"
                                        Height="30" MinWidth="140"
                                        local:ButtonHelper.CornerRadius="3"
                                        Background="#0A0818" BorderBrush="#2A1050" BorderThickness="1"
                                        Click="BugImageBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;"
                                                   FontSize="12" Foreground="#7733BB"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BugImageBtnText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="10" FontWeight="Bold" Foreground="#5522AA"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="BugImageFileName"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" Foreground="#2A1050"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="210"/>
                            </StackPanel>

                            <!-- Status message -->
                            <TextBlock x:Name="BugStatusText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="10" Foreground="#CC4422"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#07101A"
                            BorderBrush="#1A0838" BorderThickness="0,1,0,0">
                        <Grid Margin="14,0">
                            <Button x:Name="SendBugReportBtn"
                                    Height="36" MinWidth="160"
                                    local:ButtonHelper.CornerRadius="3"
                                    Background="#1A0830" BorderBrush="#5A2A90" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="SendBugReportBtn_Click">
                                <TextBlock x:Name="SendBugReportBtnText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold" Foreground="#9944CC"/>
                            </Button>
                            <Button x:Name="CloseBugReportBtn"
                                    Height="36" MinWidth="120"
                                    local:ButtonHelper.CornerRadius="3"
                                    Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseBugReportBtn_Click">
                                <TextBlock x:Name="CloseBugReportBtnText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"/>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ── INTRO VIDEO OVERLAY ── -->
        <Grid x:Name="IntroOverlay"
              Grid.RowSpan="6"
              Background="Black"
              MouseDown="IntroOverlay_MouseDown">
            <MediaElement x:Name="IntroPlayer"
                          LoadedBehavior="Manual"
                          Stretch="Uniform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
            <TextBlock x:Name="IntroSkipText"
                       Text="[ clic para saltar ]"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="9" Foreground="#1A2A38"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,16,12"/>
        </Grid>

    </Grid>
</Window>
