<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.HotkeyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown">

    <Grid>
        <!-- Dimming backdrop — click outside panel to close -->
        <Rectangle Fill="#88000000" MouseDown="Backdrop_MouseDown"/>

        <!-- Centered content panel (width set in code) -->
        <Border x:Name="ContentPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="520"
                Background="#EF09141E"
                BorderBrush="#153048"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#060F18"
                        BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <TextBlock x:Name="HeaderText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HintText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" Foreground="#1A3A55"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Content + Buttons -->
                <DockPanel Grid.Row="1" Margin="16,14">

                    <!-- Action buttons — docked to bottom of content area -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,4" LastChildFill="False">
                        <Button x:Name="CloseBtn"
                                Height="32" Padding="14,0"
                                local:ButtonHelper.CornerRadius="3"
                                Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                DockPanel.Dock="Right"
                                Click="CloseBtn_Click">
                            <TextBlock x:Name="CloseBtnText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"/>
                        </Button>

                        <Button x:Name="LoadBtn"
                                Height="32" Padding="14,0"
                                local:ButtonHelper.CornerRadius="3"
                                Background="#00503C" BorderBrush="#00B482" BorderThickness="1"
                                DockPanel.Dock="Left"
                                IsEnabled="False"
                                Click="LoadBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"
                                           FontSize="13" Foreground="#00CCAA"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LoadBtnText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold" Foreground="#00CCAA"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DeleteBtn"
                                Height="32" Padding="14,0"
                                local:ButtonHelper.CornerRadius="3"
                                Background="#1A0606" BorderBrush="#440000" BorderThickness="1"
                                DockPanel.Dock="Left" Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="DeleteBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"
                                           FontSize="13" Foreground="#CC3333"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DeleteBtnText"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold" Foreground="#CC3333"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Chapter content — built entirely in code-behind -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                        <StackPanel x:Name="ChaptersPanel"/>
                    </ScrollViewer>

                </DockPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
