<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.LeaderboardOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown">

    <Grid>
        <Rectangle Fill="#BB000000" MouseDown="Backdrop_MouseDown"/>

        <Border Width="1150" Height="760"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#EF07101A" BorderBrush="#0D3020" BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ── -->
                <Border Grid.Row="0" Background="#05090F"
                        BorderThickness="0,0,0,1" BorderBrush="#0D2030"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Ellipse Width="8" Height="8" Fill="#00CCAA" VerticalAlignment="Center"/>
                            <TextBlock Text="SPEEDRUN.COM LEADERBOARDS"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontWeight="Bold" FontSize="13" Foreground="#00CCAA"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="CloseBtn"
                                Width="28" Height="28"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                local:ButtonHelper.CornerRadius="4"
                                Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                Click="CloseBtn_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                       FontSize="12" Foreground="#3A6A8A"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── BODY ── -->
                <Grid Grid.Row="1" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChapterListPanel"/>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RunTypesPanel" Margin="0,0,4,0"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
