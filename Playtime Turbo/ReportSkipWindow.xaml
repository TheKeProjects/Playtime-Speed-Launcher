<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.ReportSkipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    Title="Report a Skip"
    WindowStartupLocation="CenterOwner"
    AllowsTransparency="True"
    WindowStyle="None"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Width="440" Height="720">

    <Window.Resources>

        <!-- Custom scrollbar thumb -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#1A3A55" CornerRadius="3" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom vertical scrollbar (thin, dark) -->
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#050C14" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollViewer template -->
        <Style x:Key="CustomScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource CustomScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#EF07101A"
            BorderBrush="#153048" BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Border Grid.Row="0" Background="#05090F"
                    BorderBrush="#0D2030" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00CCAA"
                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="REPORT A SKIP"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="Close_Click"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            local:ButtonHelper.CornerRadius="4"
                            Background="#0A1825" BorderBrush="#0D2535"
                            BorderThickness="1" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                   Foreground="#3A6A8A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Content ── -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Style="{StaticResource CustomScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Know a skip or glitch that isn't in the list yet? Send it here and it'll be reviewed for the Skips and Glitches menu."
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" Foreground="#3A6A8A"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="SKIP NAME *" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <Border Background="#060D18" BorderBrush="#0D2030" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                            <TextBox x:Name="SkipNameBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#C8D8E4" CaretBrush="#00CCAA" SelectionBrush="#00CCAA"
                                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                                     Padding="8,7" MaxLength="80"/>
                        </Border>

                        <TextBlock Text="CHAPTER" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="ChapterPanel" Margin="0,0,0,12"/>

                        <TextBlock Text="VERSION" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="VersionPanel" Margin="0,0,0,12"/>

                        <TextBlock Text="RUN CATEGORY" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RunCategoryPanel" Margin="0,0,0,12"/>

                        <TextBlock Text="ROUTE" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RoutePanel" Margin="0,0,0,12"/>

                        <TextBlock Text="RESTRICTIONS" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RestrictionsPanel" Margin="0,0,0,12"/>

                        <CheckBox x:Name="CoresCheckBox"
                                  Content="Uses core / hardware exploit"
                                  Foreground="#8AABBD"
                                  FontFamily="Cascadia Code, Consolas, Courier New"
                                  FontSize="10" Margin="0,0,0,16"/>

                        <TextBlock Text="VIDEO URL" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <Border Background="#060D18" BorderBrush="#0D2030" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                            <TextBox x:Name="VideoUrlBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#C8D8E4" CaretBrush="#00CCAA" SelectionBrush="#00CCAA"
                                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                                     Padding="8,7" MaxLength="200"/>
                        </Border>

                        <TextBlock Text="AUTHOR / DISCOVERED BY" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <Border Background="#060D18" BorderBrush="#0D2030" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                            <TextBox x:Name="AuthorBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#C8D8E4" CaretBrush="#00CCAA" SelectionBrush="#00CCAA"
                                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                                     Padding="8,7" MaxLength="60"/>
                        </Border>

                        <TextBlock Text="DESCRIPTION" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" FontWeight="Bold" Foreground="#00CCAA" Margin="0,0,0,4"/>
                        <Border Background="#060D18" BorderBrush="#0D2030" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="DescriptionBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#C8D8E4" CaretBrush="#00CCAA" SelectionBrush="#00CCAA"
                                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                                     Padding="8,7" MaxLength="400"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="70" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="StatusText" Grid.Row="1"
                           Text="" Visibility="Collapsed"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="10" FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>

                <Button x:Name="SendButton" Grid.Row="2"
                        Click="SendButton_Click"
                        Height="38" Margin="0,14,0,0"
                        local:ButtonHelper.CornerRadius="6"
                        Background="#00CCAA" BorderThickness="0" Cursor="Hand">
                    <TextBlock x:Name="SendButtonText" Text="Send Report"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="12" FontWeight="Bold" Foreground="#03110D"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
