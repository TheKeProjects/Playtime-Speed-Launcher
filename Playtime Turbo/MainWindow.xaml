                                        Height="36" MinWidth="110"
                                        local:ButtonHelper.CornerRadius="3"
                                        Background="#00503C" BorderBrush="#00B482" BorderThickness="1"
                                        Padding="16,0" Margin="0,0,10,0"
                                        Click="FullBrightYesBtn_Click">
                                    <TextBlock Text="YES"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#00CCAA"/>
                                </Button>
                                <Button x:Name="FullBrightNoBtn"
                                        Height="36" MinWidth="110"
                                        local:ButtonHelper.CornerRadius="3"
                                        Background="#1A0606" BorderBrush="#440000" BorderThickness="1"
                                        Padding="16,0"
                                        Click="FullBrightNoBtn_Click">
                                    <TextBlock Text="NO"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#CC3333"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
