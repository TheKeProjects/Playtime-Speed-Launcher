                        <!-- Why -->
                        <TextBlock x:Name="DiscordInfoWhyTitle"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" FontWeight="Bold" Foreground="#9944CC"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="DiscordInfoWhyText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" Foreground="#8AAABB"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- Permissions -->
                        <TextBlock x:Name="DiscordInfoPermsTitle"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="10" FontWeight="Bold" Foreground="#9944CC"
                                   Margin="0,0,0,8"/>

                        <!-- identify permission row -->
                        <Border Background="#060B14"
                                BorderBrush="#1A1A38" BorderThickness="1"
                                CornerRadius="3" Padding="12,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DiscordInfoPermIdentifyName"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="10" FontWeight="Bold" Foreground="#7755CC"/>
                                    <TextBlock x:Name="DiscordInfoPermIdentifyDesc"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="9" Foreground="#4A5A7A"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Green checkmark -->
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#336644"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- No access list -->
                        <TextBlock x:Name="DiscordInfoNoAccessText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="9" Foreground="#334444"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#07101A"
                            BorderBrush="#1A0838" BorderThickness="0,1,0,0">
