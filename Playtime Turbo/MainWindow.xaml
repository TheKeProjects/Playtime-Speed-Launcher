<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeedrunLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeedrunLauncher"
    Title="Poppy Playtime — Speedrun Launcher"
    WindowState="Maximized"
    WindowStyle="None"
    ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#070C12"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ── TOP STATUS BAR ── -->
        <Border Grid.Row="0" Background="#08111A"
                BorderBrush="#0D2030" BorderThickness="0,0,0,1"/>
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0">
            <Image x:Name="TrophyImage"
                   Width="16" Height="16"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Approved by SPEEDRUN.COM"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="10" Foreground="#00CC66"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
            <Button x:Name="MinimizeBtn"
                    Background="Transparent" BorderThickness="0"
                    Padding="0" Click="MinimizeBtn_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    ToolTip="Minimize">
                <Border BorderBrush="#1A3A55" BorderThickness="1"
                        CornerRadius="3" Padding="8,4">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;"
                               FontSize="10" Foreground="#2A5A7A"/>
                </Border>
            </Button>
            <TextBlock x:Name="VersionLabel"
                       Text="v1.0.0"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="10" Foreground="#1A3A55"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── CHAPTER CARDS ── -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center">
            <StackPanel x:Name="CardsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40,8"/>
        </ScrollViewer>

        <!-- ── CHAPTER INFO ── -->
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,8">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#FFAA00"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="12" Foreground="#2A5A7A"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
                <Button Background="Transparent" BorderThickness="0"
                        Padding="0" Click="VersionBtn_Click"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                    <Border BorderBrush="#1A3A55" BorderThickness="1"
                            CornerRadius="3" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VersionText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13" Foreground="#00CCAA"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;"
                                       FontSize="10" Foreground="#1A4060"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button x:Name="PlatformToggleBtn"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Click="PlatformToggleBtn_Click"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <Border x:Name="PlatformToggleBorder"
                            BorderBrush="#1A3A55" BorderThickness="1"
                            CornerRadius="3" Padding="10,4">
                        <TextBlock x:Name="PlatformToggleText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#2A5A7A"/>
                    </Border>
                </Button>
            </StackPanel>

            <TextBlock x:Name="DescriptionText"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="14" Foreground="#2A5A7A"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="900"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ── ACTION BUTTONS ── -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,14">

            <Button x:Name="LeaderboardButton"
                    Width="58" Height="58"
                    local:ButtonHelper.CornerRadius="5"
                    Background="#0A1825" BorderBrush="#112233"
                    BorderThickness="2"
                    ToolTipService.ToolTip="Leaderboard"
                    Click="LeaderboardButton_Click">
                <Image x:Name="LeaderboardTrophyImage"
                       Width="26" Height="26"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>

            <Grid Margin="8,0,0,0">
                <Button x:Name="SettingsButton"
                        Width="58" Height="58"
                        local:ButtonHelper.CornerRadius="5"
                        Background="#0A1825" BorderBrush="#112233"
                        BorderThickness="2"
                        ToolTipService.ToolTip="Configuración"
                        Click="SettingsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"
                               FontSize="22" Foreground="#3A6A8A"/>
                </Button>
                <Button x:Name="SettingsUpdateBadge"
                        Width="20" Height="20"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-5,-5,0"
                        Background="#CC2200" BorderThickness="0"
                        local:ButtonHelper.CornerRadius="10"
                        Visibility="Collapsed"
                        Panel.ZIndex="10"
                        Click="SettingsUpdateBadge_Click">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <Button x:Name="PlayButton"
                    Height="58" MinWidth="260"
                    local:ButtonHelper.CornerRadius="5"
                    Background="#00CCAA" BorderThickness="0"
                    Click="PlayButton_Click"
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;"
                               FontSize="16" Foreground="#060C12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlayButtonText"
                               Text="JUGAR CAPÍTULO"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#060C12"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="QuitButton"
                    Width="58" Height="58"
                    local:ButtonHelper.CornerRadius="5"
                    Background="#1A0606" BorderBrush="#440000"
                    BorderThickness="1"
                    Click="QuitButton_Click"
                    Margin="8,0,0,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;"
                           FontSize="20" Foreground="#CC3333"/>
            </Button>

        </StackPanel>

        <!-- ── BOTTOM BAR ── -->
        <Border Grid.Row="5" Background="#08111A"
                BorderBrush="#0D2030" BorderThickness="0,1,0,0"/>

        <Button x:Name="BugReportButton"
                Grid.Row="5"
                Height="24"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="12,0,0,0"
                local:ButtonHelper.CornerRadius="3"
                Background="#0C0814" BorderBrush="#28104A" BorderThickness="1"
                Click="BugReportButton_Click">
            <StackPanel Orientation="Horizontal" Margin="8,0,8,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE730;"
                           FontSize="10" Foreground="#6633AA"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BugReportBtnText"
                           Text="REPORTAR ERROR"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="9" FontWeight="Bold" Foreground="#5522AA"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </Button>

        <Button x:Name="BeginnerTutorialsBtn"
                Grid.Row="5"
                Height="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                local:ButtonHelper.CornerRadius="3"
                Background="#060F18" BorderBrush="#003322" BorderThickness="1"
                Click="BeginnerTutorialsBtn_Click">
            <StackPanel Orientation="Horizontal" Margin="8,0,8,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;"
                           FontSize="10" Foreground="#007755"
                           VerticalAlignment="Center"/>
                <TextBlock Text="TUTORIALS"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="9" FontWeight="Bold" Foreground="#007755"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </Button>

        <Button x:Name="ChangelogButton"
                Grid.Row="5"
                Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,12,0"
                local:ButtonHelper.CornerRadius="3"
                Background="#060F18" BorderBrush="#0D2535" BorderThickness="1"
                Click="ChangelogButton_Click">
            <StackPanel Orientation="Horizontal" Margin="8,0,8,0">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;"
                           FontSize="10" Foreground="#1A4060"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChangelogBtnText"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="9" FontWeight="Bold" Foreground="#1A4060"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </Button>

        <!-- Steam user (above footer, bottom-right) -->
        <StackPanel x:Name="SteamUserPanel"
                    Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,14"
                    Visibility="Collapsed">
            <TextBlock x:Name="SteamPersonaName"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="13" FontWeight="Bold"
                       Foreground="#3A6A8A"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True">
                <Image x:Name="SteamAvatar" Stretch="UniformToFill"/>
            </Border>
        </StackPanel>

        <!-- ── VERSIONS OVERLAY ── -->
        <Grid x:Name="VersionsOverlay"
              Grid.RowSpan="6"
              Visibility="Collapsed"
              Background="#BB000000">

            <Border Width="700" Height="500"
                    Background="#09141E"
                    BorderBrush="#153048" BorderThickness="1"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#060F18"
                            BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                        <Grid Margin="6,0">
                            <Button x:Name="PrevChapterBtn"
                                    Background="Transparent" BorderThickness="0"
                                    Width="38" Height="38"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="PrevChapterBtn_Click">
                                <TextBlock Text="&#x2190;"
                                           FontFamily="Consolas" FontSize="20"
                                           Foreground="#00CCAA"/>
                            </Button>

                            <TextBlock x:Name="VersionsHeader"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#00CCAA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="NextChapterBtn"
                                    Background="Transparent" BorderThickness="0"
                                    Width="38" Height="38"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="NextChapterBtn_Click">
                                <TextBlock Text="&#x2192;"
                                           FontFamily="Consolas" FontSize="20"
                                           Foreground="#00CCAA"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InstallsList"
                                    Margin="12,10"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#060F18"
                            BorderBrush="#0D2030" BorderThickness="0,1,0,0">
                        <Grid Margin="14,0">
                            <Button x:Name="AddInstallBtn"
                                    Height="36" MinWidth="120"
                                    local:ButtonHelper.CornerRadius="3"
                                    Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="AddInstallBtn_Click">
                                <TextBlock x:Name="AddInstallBtnText"
                                           Text="AÑADIR"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#00CCAA"/>
                            </Button>
                            <Button x:Name="TogglePresetsBtn"
                                    Height="36" MinWidth="150"
                                    local:ButtonHelper.CornerRadius="3"
                                    Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Click="TogglePresetsBtn_Click"/>
                            <Button x:Name="CloseVersionsBtn"
                                    Height="36" MinWidth="120"
                                    local:ButtonHelper.CornerRadius="3"
                                    Background="#0A1825" BorderBrush="#0D2535" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="CloseVersionsBtn_Click">
                                <TextBlock x:Name="CloseVersionsBtnText"
                                           Text="VOLVER"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#3A6A8A"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── SETTINGS OVERLAY ── -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="6"
              Visibility="Collapsed"
              Background="#BB000000">
            <Border Width="620" Height="520" Background="#09141E"
                    BorderBrush="#153048" BorderThickness="1"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#060F18"
                            BorderBrush="#0D2030" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SettingsHeaderText"
                                   Text="[ CONFIGURACIÓN ]"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13" FontWeight="Bold" Foreground="#00CCAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Sidebar + content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar -->
                        <Border Grid.Column="0" Background="#060F18"
                                BorderBrush="#0D2030" BorderThickness="0,0,1,0">
                            <StackPanel Margin="0,14,0,0">
                                <Button x:Name="SettingsTabGeneralBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabGeneral_Click">
                                    <Border x:Name="SettingsTabGeneralBorder"
                                            BorderBrush="#00CCAA" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabGeneralText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#00CCAA"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabControlsBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabControls_Click">
                                    <Border x:Name="SettingsTabControlsBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabControlsText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabSteamBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabSteam_Click">
                                    <Border x:Name="SettingsTabSteamBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabSteamText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabControllerBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabController_Click">
                                    <Border x:Name="SettingsTabControllerBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabControllerText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabDiscordBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabDiscord_Click">
                                    <Border x:Name="SettingsTabDiscordBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabDiscordText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabUpdatesBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabUpdates_Click">
                                    <Border x:Name="SettingsTabUpdatesBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border x:Name="SettingsTabUpdatesAlertBorder"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="3" Padding="4,2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="SettingsTabUpdatesText"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabLiveSplitBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabLiveSplit_Click">
                                    <Border x:Name="SettingsTabLiveSplitBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabLiveSplitText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabCoresBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabCores_Click">
                                    <Border x:Name="SettingsTabCoresBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabCoresText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabOverlaysBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabOverlays_Click">
                                    <Border x:Name="SettingsTabOverlaysBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabOverlaysText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="SettingsTabIconThemeBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="36"
                                        Click="SettingsTabIconTheme_Click">
                                    <Border x:Name="SettingsTabIconThemeBorder"
                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                            Padding="14,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock x:Name="SettingsTabIconThemeText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#3A6A8A"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Tab contents (stacked, only one visible at a time) -->
                        <Grid Grid.Column="1">

                            <!-- ═══ GENERAL TAB ═══ -->
                            <ScrollViewer x:Name="SettingsGeneralScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24,18">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="SoundEffectsLabel"
                                                   Text="Efectos de sonido"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="12" Foreground="#8AAABB"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="VolumeValueText"
                                                   Text="50%"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" Foreground="#00CCAA"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0" Maximum="100" Value="50"
                                            SmallChange="1"
                                            ValueChanged="VolumeSlider_ValueChanged"
                                            Margin="0,0,0,16"/>

                                    <Border BorderBrush="#0D2030" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                                    <Grid>
                                        <TextBlock x:Name="LanguageLabel"
                                                   Text="Idioma"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="12" Foreground="#8AAABB"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="LangSelectorBtn"
                                                    Height="30" MinWidth="130"
                                                    local:ButtonHelper.CornerRadius="4"
                                                    Background="#0A1825" BorderBrush="#1A3A55" BorderThickness="1"
                                                    Padding="10,0,8,0"
