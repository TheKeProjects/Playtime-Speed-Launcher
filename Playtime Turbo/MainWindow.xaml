                    <Border Grid.Row="0" Background="#07101A"
                            BorderBrush="#1A0838" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="DiscordInfoHeader"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="12" FontWeight="Bold" Foreground="#9944CC"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
