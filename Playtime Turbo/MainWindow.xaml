                                       FontSize="9" FontWeight="Bold" Foreground="#5522AA"
                                       Margin="0,0,0,6"/>

                            <!-- Connect button + info button row -->
                            <StackPanel x:Name="BugDiscordConnectRow"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <Button x:Name="BugDiscordConnectBtn"
                                        Height="34" HorizontalAlignment="Left"
                                        local:ButtonHelper.CornerRadius="3"
                                        Background="#0E0818" BorderBrush="#2A1050" BorderThickness="1"
                                        Padding="14,0"
                                        Click="BugDiscordConnectBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BD;"
                                                   FontSize="13" Foreground="#7722AA"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BugDiscordConnectBtnText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="10" FontWeight="Bold" Foreground="#7722AA"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BugDiscordInfoBtn"
                                        Width="26" Height="26"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        local:ButtonHelper.CornerRadius="13"
                                        Background="Transparent" BorderBrush="#2A1050" BorderThickness="1"
                                        Click="BugDiscordInfoBtn_Click">
                                    <TextBlock Text="?"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11" FontWeight="Bold" Foreground="#5522AA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Waiting for browser authorization -->
                            <StackPanel x:Name="BugDiscordWaiting"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="BugDiscordWaitingText"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="9" Foreground="#5522AA"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="BugDiscordCancelAuthBtn"
                                            Height="20"
                                            local:ButtonHelper.CornerRadius="2"
                                            Background="Transparent" BorderBrush="#2A1050" BorderThickness="1"
                                            Padding="8,0" Margin="10,0,0,0"
                                            Click="BugDiscordCancelAuthBtn_Click">
                                        <TextBlock x:Name="BugDiscordCancelAuthBtnText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="9" FontWeight="Bold" Foreground="#5522AA"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Connected state: username only + × to disconnect -->
                            <Border x:Name="BugDiscordConnected"
                                    Visibility="Collapsed"
                                    Background="#061408"
                                    BorderBrush="#1A3A1A" BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,8"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BD;"
                                                   FontSize="14" Foreground="#00CC88"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BugDiscordUsername"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="11" FontWeight="Bold" Foreground="#00CC88"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BugDiscordDisconnectBtn"
                                            Width="22" Height="22"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            local:ButtonHelper.CornerRadius="11"
                                            Background="Transparent" BorderBrush="#2A4A2A" BorderThickness="1"
                                            Click="BugDiscordDisconnectBtn_Click">
                                        <TextBlock Text="✕"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="9" Foreground="#336633"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Error title (required) -->
                            <TextBlock x:Name="BugETitleLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#9944CC"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="BugETitleBox"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="11"
                                     Background="#080C18" Foreground="#CCEEFF"
                                     BorderBrush="#2A1050" BorderThickness="1"
                                     CaretBrush="#9944CC"
                                     Padding="8,6"
                                     Margin="0,0,0,14"/>

                            <!-- Description (required) -->
                            <TextBlock x:Name="BugDescLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#9944CC"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="BugDescBox"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="11"
                                     Background="#080C18" Foreground="#AABBCC"
                                     BorderBrush="#2A1050" BorderThickness="1"
                                     CaretBrush="#9944CC"
                                     Padding="8,6"
                                     Height="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,14"/>

                            <!-- Image (optional) -->
                            <TextBlock x:Name="BugImageLabel"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="9" FontWeight="Bold" Foreground="#5522AA"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BugImageBtn"
                                        Height="30" MinWidth="140"
                                        local:ButtonHelper.CornerRadius="3"
                                        Background="#0A0818" BorderBrush="#2A1050" BorderThickness="1"
                                        Click="BugImageBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;"
                                                   FontSize="12" Foreground="#7733BB"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BugImageBtnText"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="10" FontWeight="Bold" Foreground="#5522AA"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="BugImageFileName"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="9" Foreground="#2A1050"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="210"/>
                            </StackPanel>

